rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin verification
    function isAdmin() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.active == true;
    }

    // Admin accounts
    match /admins/{uid} {
      allow get: if request.auth != null
        && request.auth.uid == uid;

      allow list, create, update, delete: if false;
    }

    // Courses: public sees only Published, admins see all
    match /courses/{courseId} {
      allow read: if isAdmin() || resource.data.status == "Published";
      allow write: if isAdmin();
    }

    // Classes: public sees only Published, admins see all
    // Publish this only after the new code is deployed.
    match /classes/{classId} {
      allow read: if isAdmin() || resource.data.status == "Published";
      allow write: if isAdmin();
    }

    // PDFs: public sees only Published, admins see all
    match /pdfs/{pdfId} {
      allow read: if isAdmin() || resource.data.status == "Published";
      allow write: if isAdmin();
    }

    // Projects: public sees only Published, admins see all
    match /projects/{projectId} {
      allow read: if isAdmin() || resource.data.status == "Published";
      allow write: if isAdmin();
    }

    // Website settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Testimonials
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact enquiries
    match /enquiries/{enquiryId} {

      // Public users can submit contact enquiries
      allow create: if
        request.resource.data.keys().hasAll([
          'name',
          'email',
          'phone',
          'subject',
          'message',
          'status',
          'createdAt'
        ])
        &&
        request.resource.data.keys().hasOnly([
          'name',
          'email',
          'phone',
          'subject',
          'message',
          'status',
          'createdAt'
        ])
        &&
        request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 150
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'New'
        && request.resource.data.createdAt == request.time;

      // Only authorized admins can manage enquiries
      allow read, update, delete: if isAdmin();
    }

    // Block all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
